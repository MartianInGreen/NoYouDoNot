# Required: TypeSafe Jev (create a key at https://console.typesafe.ai)
TYPESAFE_API_KEY=sk_replace_me
TYPESAFE_MODEL=jev-latest

# Required between the extension and this localhost bridge.
# Generate one with: openssl rand -hex 24
NOYOUDONOT_BRIDGE_TOKEN=replace_with_a_long_random_value
PORT=4317

# Optional: an OpenAI-compatible chat endpoint for intervention conversations.
# The URL may end in /v1 or /v1/chat/completions.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace_me
LLM_MODEL=gpt-4o-mini

# Optional diagnostics. Never use debug logging with sensitive browsing data.
LOG_LEVEL=info
